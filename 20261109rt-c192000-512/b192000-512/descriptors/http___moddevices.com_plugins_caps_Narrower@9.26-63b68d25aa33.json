{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "http://moddevices.com/plugins/caps/Narrower",
    "uri": "http://moddevices.com/plugins/caps/Narrower",
    "name": "C* Narrower - Stereo image width reduction",
    "vendor": "MOD Team",
    "version": "9.26",
    "doc": "This plugin reduces the width of a stereophonic signal. Its primary use is for preventing fatigue from listening to 'creatively panned' music on headphones. Mid/side processing tends to sound more transparent for moderate strength settings. However, it will more strongly attenuate signals that are panned to the far sides of the stereo image (rarely encountered in contemporary music production anymore but quite common, for example, on early Beatles recordings or others from that time). source: http://quitte.de/dsp/caps.html#Narrower",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "mode",
      "name": "Mode",
      "kind": "choice",
      "ids": [
        "crossfeedMixing",
        "midSideProcessing"
      ],
      "labels": [
        "Crossfeed Mixing",
        "Mid/Side Processing"
      ],
      "values": [
        0.0,
        1.0
      ],
      "default": "crossfeedMixing",
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Narrower.lv2/Narrower.ttl#mode"
      }
    },
    {
      "id": "strength",
      "name": "Strength",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.25
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Narrower.lv2/Narrower.ttl#strength"
      }
    }
  ],
  "ports": [
    {
      "id": "inl",
      "name": "In Left",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "inr",
      "name": "In Right",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outl",
      "name": "Out Left",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outr",
      "name": "Out Right",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#SpatialPlugin"
    }
  },
  "source": {
    "from": "mod-caps-Narrower.lv2/Narrower.so#lv2_descriptor"
  }
}
