{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "http://moddevices.com/plugins/caps/Plate",
    "uri": "http://moddevices.com/plugins/caps/Plate",
    "name": "C* Plate - Versatile plate reverb",
    "vendor": "MOD Team",
    "version": "9.26",
    "doc": "This reverb processor is an adaptation of the design discussed in [dat97a]. Tuned for a soft attack and smooth ambience, it consists of a network of twelve delay lines of varying length. At its heart, two of these are modulated very subtly, in a chorus-like fashion. The bandwidth control reduces high-frequency content before it enters the 'tank', while damping controls how quickly the reverberating tail darkens. source: http://quitte.de/dsp/caps.html#Plate",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "bandwidth",
      "name": "Bandwidth",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.5
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Plate.lv2/Plate.ttl#bandwidth"
      }
    },
    {
      "id": "tail",
      "name": "Tail",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.75
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Plate.lv2/Plate.ttl#tail"
      }
    },
    {
      "id": "damping",
      "name": "Damping",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.5
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Plate.lv2/Plate.ttl#damping"
      }
    },
    {
      "id": "blend",
      "name": "Blend",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.25
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Plate.lv2/Plate.ttl#blend"
      }
    }
  ],
  "ports": [
    {
      "id": "in",
      "name": "In",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outl",
      "name": "Out Left",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outr",
      "name": "Out Right",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#ReverbPlugin"
    }
  },
  "source": {
    "from": "mod-caps-Plate.lv2/Plate.so#lv2_descriptor"
  }
}
