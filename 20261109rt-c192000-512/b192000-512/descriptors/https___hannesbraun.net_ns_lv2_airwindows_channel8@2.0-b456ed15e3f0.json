{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "https://hannesbraun.net/ns/lv2/airwindows/channel8",
    "uri": "https://hannesbraun.net/ns/lv2/airwindows/channel8",
    "name": "Channel8",
    "vendor": "Hannes Braun",
    "version": "2.0",
    "doc": "Channel7 with updates from Capacitor2 and Slew3. More and better of what Channel is.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "consoletype",
      "name": "Console Type",
      "kind": "choice",
      "ids": [
        "neve",
        "aPI",
        "sSL"
      ],
      "labels": [
        "Neve",
        "API",
        "SSL"
      ],
      "values": [
        0.0,
        1.0,
        2.0
      ],
      "default": "neve",
      "meaning": "unknown",
      "source": {
        "from": "Airwindows.lv2/Channel8.ttl#consoletype"
      }
    },
    {
      "id": "drive",
      "name": "Drive",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 200.0,
        "unit": "%",
        "scale": "linear",
        "default": 0.0
      },
      "meaning": "unknown",
      "source": {
        "from": "Airwindows.lv2/Channel8.ttl#drive"
      }
    },
    {
      "id": "output",
      "name": "Output",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "x",
        "scale": "linear",
        "default": 1.0
      },
      "meaning": "unknown",
      "source": {
        "from": "Airwindows.lv2/Channel8.ttl#output"
      }
    }
  ],
  "ports": [
    {
      "id": "inL",
      "name": "In L",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "inR",
      "name": "In R",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outL",
      "name": "Out L",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outR",
      "name": "Out R",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#Plugin"
    }
  },
  "source": {
    "from": "Airwindows.lv2/Channel8.so#lv2_descriptor"
  }
