    "id": "niallmoody.ndcplugs.cycleshifter",
    "name": "Cycle Shifter",
    "vendor": "ndc Plugs",
    "doc": "Reads in a cycle's-worth of the input signal, then (once the whole cycle's been read in) outputs it again, on top of the current output. Works best with long/sustained sounds (e.g. strings, pads etc.), sounds like a weird kind of gentle distortion.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "name": "New Cycle Vol",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 1,
        "unit": "unknown",
        "scale": "unknown",
        "default": 1
      },
      "group": [
        "ncvolume"
      ],
      "meaning": "unknown",
      "automatable": true,
      "source": {
        "from": "CycleShifter.clap#clap_entry[niallmoody.ndcplugs.cycleshifter][0]"
      }
    },
    {
      "id": 1,
      "name": "Input Vol",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 1,
        "unit": "unknown",
        "scale": "unknown",
        "default": 1
      },
      "group": [
        "ipvolume"
      ],
      "meaning": "unknown",
      "automatable": true,
      "source": {
        "from": "CycleShifter.clap#clap_entry[niallmoody.ndcplugs.cycleshifter][1]"
