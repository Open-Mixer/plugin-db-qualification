{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "clap",
    "id": "com.zamaudio.ZamEcho",
    "name": "ZamEcho",
    "vendor": "Damien Zammit",
    "doc": "A simple mono echo plugin",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "name": "Echo",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 1,
        "unit": "unknown",
        "scale": "unknown",
        "default": 0.5
      },
      "group": [
        "echo"
      ],
      "meaning": "unknown",
      "automatable": true,
      "source": {
        "from": "ZamEcho.clap#clap_entry[com.zamaudio.ZamEcho][0]"
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "Audio Input",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": 0,
      "name": "Audio Output",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "latency": {
    "reports": false
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "audio-effect",
        "delay",
        "mono"
      ]
    }
  },
  "source": {
    "from": "ZamEcho.clap#clap_entry[com.zamaudio.ZamEcho]"
  }
