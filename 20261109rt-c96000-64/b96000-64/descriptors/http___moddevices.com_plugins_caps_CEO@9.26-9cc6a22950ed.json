{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "http://moddevices.com/plugins/caps/CEO",
    "uri": "http://moddevices.com/plugins/caps/CEO",
    "name": "C* CEO - Chief Executive Oscillator",
    "vendor": "MOD Team",
    "version": "9.26",
    "doc": "The Chief Executive Oscillator forever calls for more profit. Sound data created with the flite[flite] application. source: http://quitte.de/dsp/caps.html#CEO",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "ppm",
      "name": "Profit per minute",
      "kind": "travel",
      "travel": {
        "min": 30.0,
        "max": 232.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 80.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-CEO.lv2/CEO.ttl#ppm"
      }
    },
    {
      "id": "volume",
      "name": "Volume",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.75
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-CEO.lv2/CEO.ttl#volume"
      }
    },
    {
      "id": "damping",
      "name": "Damping",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-CEO.lv2/CEO.ttl#damping"
      }
    }
  ],
  "ports": [
    {
      "id": "out",
      "name": "Out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#OscillatorPlugin"
    }
  },
  "source": {
    "from": "mod-caps-CEO.lv2/CEO.so#lv2_descriptor"
  }
}
