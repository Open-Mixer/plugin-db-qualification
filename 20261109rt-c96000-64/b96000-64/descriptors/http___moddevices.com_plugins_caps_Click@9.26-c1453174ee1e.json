{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "http://moddevices.com/plugins/caps/Click",
    "uri": "http://moddevices.com/plugins/caps/Click",
    "name": "C* Click - Metronome",
    "vendor": "MOD Team",
    "version": "9.26",
    "doc": "A sample-accurate metronome. Two simplistic modal synthesis models are available for the click: box is a small wooden box struck with a soft wooden mallet, stick a scratchy stick hit. In addition, there's also a very synthetic beep, and finally dirac, a very nasty single-sample pulse of 0 dB amplitude and little immediate musical use. All click sounds are synthesised once when the plugin is loaded and then played back from memory. source: http://quitte.de/dsp/caps.html#Click",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "model",
      "name": "Model",
      "kind": "choice",
      "ids": [
        "box",
        "stick",
        "beep",
        "dirac"
      ],
      "labels": [
        "Box",
        "Stick",
        "Beep",
        "Dirac"
      ],
      "values": [
        0.0,
        1.0,
        2.0,
        3.0
      ],
      "default": "stick",
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Click.lv2/Click.ttl#model"
      }
    },
    {
      "id": "bpm",
      "name": "BPM",
      "kind": "travel",
      "travel": {
        "min": 4.0,
        "max": 240.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 63.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Click.lv2/Click.ttl#bpm"
      }
    },
    {
      "id": "div",
      "name": "Divider",
      "kind": "choice",
      "ids": [
        "v0",
        "v1",
        "v2",
        "v3"
      ],
      "labels": [
        "♩",
        "♪♪",
        "♪♪♪",
        "♬♬"
      ],
      "values": [
        1.0,
        2.0,
        3.0,
        4.0
      ],
      "default": "v0",
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Click.lv2/Click.ttl#div"
      }
    },
    {
      "id": "vol",
      "name": "Volume",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.25
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Click.lv2/Click.ttl#vol"
      }
    },
    {
      "id": "tone",
      "name": "Tone",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.75
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Click.lv2/Click.ttl#tone"
      }
    }
  ],
  "ports": [
    {
      "id": "out",
      "name": "Out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#UtilityPlugin"
    }
  },
  "source": {
    "from": "mod-caps-Click.lv2/Click.so#lv2_descriptor"
  }
}
