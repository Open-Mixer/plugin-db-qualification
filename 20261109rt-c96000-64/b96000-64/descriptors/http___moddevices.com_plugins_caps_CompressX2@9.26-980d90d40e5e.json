{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "http://moddevices.com/plugins/caps/CompressX2",
    "uri": "http://moddevices.com/plugins/caps/CompressX2",
    "name": "C* CompressX2 - Stereo compressor",
    "vendor": "MOD Team",
    "version": "9.26",
    "doc": "This stereo version of Compress applies uniform compression to both channels in proportion to their combined power. source: http://quitte.de/dsp/caps.html#Compress",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "measure",
      "name": "Measure",
      "kind": "choice",
      "ids": [
        "peak",
        "rms"
      ],
      "labels": [
        "peak",
        "rms"
      ],
      "values": [
        0.0,
        1.0
      ],
      "default": "peak",
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-CompressX2.lv2/CompressX2.ttl#measure"
      }
    },
    {
      "id": "mode",
      "name": "Mode",
      "kind": "choice",
      "ids": [
        "linear",
        "saturating2x",
        "saturating4x"
      ],
      "labels": [
        "linear",
        "saturating 2x",
        "saturating 4x"
      ],
      "values": [
        0.0,
        1.0,
        2.0
      ],
      "default": "saturating2x",
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-CompressX2.lv2/CompressX2.ttl#mode"
      }
    },
    {
      "id": "threshold",
      "name": "Threshold",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.5
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-CompressX2.lv2/CompressX2.ttl#threshold"
      }
    },
    {
      "id": "strength",
      "name": "Strength",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.25
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-CompressX2.lv2/CompressX2.ttl#strength"
      }
    },
    {
      "id": "attack",
      "name": "Attack",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.75
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-CompressX2.lv2/CompressX2.ttl#attack"
      }
    },
    {
      "id": "release",
      "name": "Release",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.5
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-CompressX2.lv2/CompressX2.ttl#release"
      }
    },
    {
      "id": "gain",
      "name": "Gain",
      "kind": "travel",
      "travel": {
        "min": -12.0,
        "max": 36.0,
        "unit": "dB",
        "scale": "linear",
        "default": 12.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-CompressX2.lv2/CompressX2.ttl#gain"
      }
    },
    {
      "id": "state",
      "name": "State",
      "kind": "travel",
      "travel": {
        "min": -144.0,
        "max": 0.0,
        "unit": "dB",
        "scale": "linear",
        "default": 0.0
      },
      "meaning": "unknown",
      "readonly": true,
      "source": {
        "from": "mod-caps-CompressX2.lv2/CompressX2.ttl#state"
      }
    }
  ],
  "ports": [
    {
      "id": "in_l",
      "name": "In Left",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "in_r",
      "name": "In Right",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "out_l",
      "name": "Out Left",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    },
    {
      "id": "out_r",
      "name": "Out Right",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#CompressorPlugin"
    }
  },
  "source": {
    "from": "mod-caps-CompressX2.lv2/CompressX2.so#lv2_descriptor"
  }
}
