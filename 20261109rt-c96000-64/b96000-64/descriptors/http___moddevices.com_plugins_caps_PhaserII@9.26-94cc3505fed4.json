{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "http://moddevices.com/plugins/caps/PhaserII",
    "uri": "http://moddevices.com/plugins/caps/PhaserII",
    "name": "C* PhaserII - Mono phaser modulated by a Lorenz fractal",
    "vendor": "MOD Team",
    "version": "9.26",
    "doc": "This take on the classic effect features two modulation choices, traditional sine-based periodicity or smoothened fractal oscillation. Very high resonance settings can cause self-oscillation peaking in excess of 0 dB. source: http://quitte.de/dsp/caps.html#PhaserII",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "rate",
      "name": "Rate",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.25
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-PhaserII.lv2/PhaserII.ttl#rate"
      }
    },
    {
      "id": "lfo",
      "name": "LFO",
      "kind": "choice",
      "ids": [
        "sine",
        "fractal"
      ],
      "labels": [
        "Sine",
        "Fractal"
      ],
      "values": [
        0.0,
        1.0
      ],
      "default": "sine",
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-PhaserII.lv2/PhaserII.ttl#lfo"
      }
    },
    {
      "id": "depth",
      "name": "Depth",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.75
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-PhaserII.lv2/PhaserII.ttl#depth"
      }
    },
    {
      "id": "spread",
      "name": "Spread",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.75
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-PhaserII.lv2/PhaserII.ttl#spread"
      }
