{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "http://moddevices.com/plugins/caps/Sin",
    "uri": "http://moddevices.com/plugins/caps/Sin",
    "name": "C* Sin - Sine wave generator",
    "vendor": "MOD Team",
    "version": "9.26",
    "doc": "The old friend, indispensable for testing and tuning. source: http://quitte.de/dsp/caps.html#Sin",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "freq",
      "name": "Frequency",
      "kind": "travel",
      "travel": {
        "min": 9.999999747378752e-05,
        "max": 20000.0,
        "unit": "Hz",
        "scale": "log",
        "default": 440.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Sin.lv2/Sin.ttl#freq"
      }
    },
    {
      "id": "volume",
      "name": "Volume",
      "kind": "travel",
      "travel": {
        "min": 9.999999974752427e-07,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.5
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Sin.lv2/Sin.ttl#volume"
      }
    }
  ],
  "ports": [
    {
      "id": "out",
      "name": "Out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#OscillatorPlugin"
    }
  },
  "source": {
    "from": "mod-caps-Sin.lv2/Sin.so#lv2_descriptor"
  }
}
