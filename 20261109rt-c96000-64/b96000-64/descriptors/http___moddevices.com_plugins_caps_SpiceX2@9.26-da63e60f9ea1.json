{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "http://moddevices.com/plugins/caps/SpiceX2",
    "uri": "http://moddevices.com/plugins/caps/SpiceX2",
    "name": "C* SpiceX2",
    "vendor": "MOD Team",
    "version": "9.26",
    "doc": "Stereo version of Spice. Bass compression is governed by the sum of both channels, as in CompressX2. Nevertheless, the amount of harmonic generation differing between the two channels can have subtle effects on the stereo image. source: http://quitte.de/dsp/caps.html#Spice",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "lof",
      "name": "Low Frequency",
      "kind": "travel",
      "travel": {
        "min": 50.0,
        "max": 400.0,
        "unit": "Hz",
        "scale": "log",
        "default": 225.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-SpiceX2.lv2/SpiceX2.ttl#lof"
      }
    },
    {
      "id": "locomp",
      "name": "Low Compression",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.5
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-SpiceX2.lv2/SpiceX2.ttl#locomp"
      }
    },
    {
      "id": "logain",
      "name": "Low Gain",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.25
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-SpiceX2.lv2/SpiceX2.ttl#logain"
      }
    },
    {
      "id": "lovolume",
      "name": "Low Volume",
      "kind": "travel",
      "travel": {
        "min": -60.0,
        "max": 60.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-SpiceX2.lv2/SpiceX2.ttl#lovolume"
      }
    },
    {
      "id": "hif",
      "name": "High Frequency",
      "kind": "travel",
      "travel": {
        "min": 400.0,
        "max": 5000.0,
        "unit": "Hz",
        "scale": "log",
        "default": 1350.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-SpiceX2.lv2/SpiceX2.ttl#hif"
      }
