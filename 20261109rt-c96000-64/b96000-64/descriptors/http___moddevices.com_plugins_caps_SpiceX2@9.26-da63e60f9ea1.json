    {
      "id": "higain",
      "name": "High Gain",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.25
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-SpiceX2.lv2/SpiceX2.ttl#higain"
      }
    },
    {
      "id": "hivolume",
      "name": "Hi Volume",
      "kind": "travel",
      "travel": {
        "min": -60.0,
        "max": 60.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-SpiceX2.lv2/SpiceX2.ttl#hivolume"
