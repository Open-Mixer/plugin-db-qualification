    },
    {
      "id": "outr",
      "name": "Out Right",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#DynamicsPlugin"
    }
  },
  "source": {
    "from": "mod-caps-SpiceX2.lv2/SpiceX2.so#lv2_descriptor"
