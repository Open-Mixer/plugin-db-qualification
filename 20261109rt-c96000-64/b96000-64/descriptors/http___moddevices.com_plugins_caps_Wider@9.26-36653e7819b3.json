{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "http://moddevices.com/plugins/caps/Wider",
    "uri": "http://moddevices.com/plugins/caps/Wider",
    "name": "C* Wider - Stereo image Synthesis",
    "vendor": "MOD Team",
    "version": "9.26",
    "doc": "In addition to provoding a basic panorama control, a perception of stereo width is created using complementary filters on the two output channels. The output channels always sum to a flat frequency response. The design of this plugin owes to the Orban 245F Stereo Synthesizer. source: http://quitte.de/dsp/caps.html#Wider",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "pan",
      "name": "Pan",
      "kind": "travel",
      "travel": {
        "min": -1.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Wider.lv2/Wider.ttl#pan"
      }
    },
    {
      "id": "width",
      "name": "Width",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 1.0
      },
      "meaning": "unknown",
      "source": {
        "from": "mod-caps-Wider.lv2/Wider.ttl#width"
      }
    }
  ],
  "ports": [
    {
      "id": "in",
      "name": "In",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outl",
      "name": "Out Left",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outr",
      "name": "Out Right",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#SpatialPlugin"
    }
  },
  "source": {
    "from": "mod-caps-Wider.lv2/Wider.so#lv2_descriptor"
  }
}
