{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "https://hannesbraun.net/ns/lv2/airwindows/adclip7",
    "uri": "https://hannesbraun.net/ns/lv2/airwindows/adclip7",
    "name": "ADClip7",
    "vendor": "Hannes Braun",
    "version": "2.2",
    "doc": "The original Airwindows loudness maximizer/peak control",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "boost",
      "name": "Boost",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 18.0,
        "unit": "dB",
        "scale": "linear",
        "default": 0.0
      },
      "meaning": "unknown",
      "source": {
        "from": "Airwindows.lv2/ADClip7.ttl#boost"
      }
    },
    {
      "id": "soften",
      "name": "Soften",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.5
      },
      "meaning": "unknown",
      "source": {
        "from": "Airwindows.lv2/ADClip7.ttl#soften"
      }
    },
    {
      "id": "enhance",
      "name": "Enhance",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.5
      },
      "meaning": "unknown",
      "source": {
        "from": "Airwindows.lv2/ADClip7.ttl#enhance"
      }
    },
    {
      "id": "mode",
      "name": "Mode",
      "kind": "choice",
      "ids": [
        "normal",
        "atten",
        "clips"
      ],
      "labels": [
        "Normal",
        "Atten",
        "Clips"
      ],
      "values": [
        0.0,
        1.0,
        2.0
      ],
      "default": "normal",
      "meaning": "unknown",
      "source": {
        "from": "Airwindows.lv2/ADClip7.ttl#mode"
      }
    }
  ],
  "ports": [
    {
      "id": "inL",
      "name": "In L",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "inR",
      "name": "In R",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outL",
      "name": "Out L",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outR",
      "name": "Out R",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#Plugin"
    }
  },
  "source": {
    "from": "Airwindows.lv2/ADClip7.so#lv2_descriptor"
  }
}
