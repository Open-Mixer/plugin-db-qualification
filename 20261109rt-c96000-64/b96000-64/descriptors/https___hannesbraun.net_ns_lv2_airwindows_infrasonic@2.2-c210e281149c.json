{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "https://hannesbraun.net/ns/lv2/airwindows/infrasonic",
    "uri": "https://hannesbraun.net/ns/lv2/airwindows/infrasonic",
    "name": "Infrasonic",
    "vendor": "Hannes Braun",
    "version": "2.2",
