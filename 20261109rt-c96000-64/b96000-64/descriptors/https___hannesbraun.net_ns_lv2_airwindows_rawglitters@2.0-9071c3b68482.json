{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.4.0"
  },
  "origin": "scanned",
  "plugin": {
    "format": "lv2",
    "id": "https://hannesbraun.net/ns/lv2/airwindows/rawglitters",
    "uri": "https://hannesbraun.net/ns/lv2/airwindows/rawglitters",
    "name": "RawGlitters",
    "vendor": "Hannes Braun",
    "version": "2.0",
    "doc": "just the quantization from Dither Me Timbers... and the opposite, as a brightener",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": "quantizer",
      "name": "Quantizer",
      "kind": "choice",
      "ids": [
        "cD16bit",
        "hD24bit"
      ],
      "labels": [
        "CD 16 bit",
        "HD 24 bit"
      ],
      "values": [
        0.0,
        1.0
      ],
      "meaning": "unknown",
      "source": {
        "from": "Airwindows.lv2/RawGlitters.ttl#quantizer"
      }
    },
    {
      "id": "deRez",
      "name": "DeRez",
      "kind": "travel",
      "travel": {
        "min": 0.0,
        "max": 1.0,
        "unit": "unknown",
        "scale": "linear",
        "default": 0.0
      },
      "meaning": "unknown",
      "source": {
        "from": "Airwindows.lv2/RawGlitters.ttl#deRez"
      }
    }
  ],
  "ports": [
    {
      "id": "inL",
      "name": "In L",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "inR",
      "name": "In R",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outL",
      "name": "Out L",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    },
    {
      "id": "outR",
      "name": "Out R",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 1
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "http://lv2plug.in/ns/lv2core#hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": false
  },
  "extensions": {
    "lv2": {
      "rdf:type": "http://lv2plug.in/ns/lv2core#GeneratorPlugin"
    }
  },
  "source": {
    "from": "Airwindows.lv2/RawGlitters.so#lv2_descriptor"
  }
