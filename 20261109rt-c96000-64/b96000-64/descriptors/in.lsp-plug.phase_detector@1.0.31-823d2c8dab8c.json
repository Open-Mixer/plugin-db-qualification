  "plugin": {
    "format": "clap",
    "id": "in.lsp-plug.phase_detector",
    "name": "Phase Detector",
    "vendor": "LSP CLAP",
    "version": "1.0.31",
    "doc": "This plugin allows one to detect phase between two sources. For example, for two or more microphones set at the different positions and distances from the sound source. The internal algorithm is based on correlation function calculation between two sources. Be aware: because there are many correlation functions for different phases calculated at one time, the entire analyzing process can take a lot of CPU resources. You can also reduce CPU utilization by lowering the maximum analysis time. The plugin bypasses input signal without any modifications, so it can be placed everywhere it's needed.",
    "features": [
      "analyzer"
    ]
  },
