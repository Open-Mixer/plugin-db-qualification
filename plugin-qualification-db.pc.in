prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@
datadir=@DATADIR@
# the DDL of the store, for a writer or a fixture builder: pkg-config --variable=schema plugin-qualification-db
schema=${datadir}/plugin-qualification-db/qualification.sql

Name: plugin-qualification-db
Description: The reader of the OpenMixer qualification store (base database and user layer); start-up only, never in a real-time path
Version: @VERSION@
Requires.private: sqlite3, libomx-domain
Cflags: -I${includedir}
Libs: -L${libdir} -lplugin-qualification-db
