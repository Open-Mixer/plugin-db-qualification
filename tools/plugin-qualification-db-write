"""plugin-qualification-db-write: put and delete records in the user or the system layer of the qualification store (this
repository's qualification store spec, section 6.1). It is the sync's writer: the module is the one that builds the base.

  put    --scope user|system --offer WORD --host-class WORD    one record, a JSON document, on standard input
  delete --scope user|system --sha256 .. --format .. --uri .. --offer .. --host-class ..

A refusal prints `plugin-qualification-db-write: refused: <name>: <file>: <path>: <why>` on standard error, writes
nothing and exits 1; a usage error exits 2; success prints nothing and exits 0. --root, --contract-dir and --schema
are for tests and for a caller with places of its own: the contract directory otherwise comes from OMX_CONTRACT_PATH,
then from the contractdir of libomx-domain.pc.
"""
import argparse
import json
import os
import subprocess
import sys

sys.dont_write_bytecode = True
# `@MODULEDIR@` is the directory the package installs the module in; a checkout leaves it, and the module is beside us
MODULEDIR = "@MODULEDIR@"
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)) if MODULEDIR.startswith("@") else MODULEDIR)
import qualification_db as q  # noqa: E402

NAME = "plugin-qualification-db-write"


def contract_dir(flag):
    if flag:
        return flag
    if os.environ.get("OMX_CONTRACT_PATH"):
        return os.environ["OMX_CONTRACT_PATH"]
    try:
        out = subprocess.run(["pkg-config", "--variable=contractdir", "libomx-domain"], capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError):
        return None
    return out.stdout.strip() or None


def main(argv):
    ap = argparse.ArgumentParser(prog=NAME, description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="verb", required=True)
    for verb in ("put", "delete"):
        sp = sub.add_parser(verb)
        sp.add_argument("--scope", required=True, choices=("user", "system"))
        sp.add_argument("--offer", required=True)
        sp.add_argument("--host-class", required=True)
        sp.add_argument("--root", help="TEST ONLY: the directory that holds the layer file, in place of the scope's")
        sp.add_argument("--schema", help="the DDL, in place of the installed one")
        if verb == "put":
            sp.add_argument("--contract-dir", help="the installed contract directory: <domain>/<domain>.json")
        else:
            sp.add_argument("--sha256", required=True)
            sp.add_argument("--format", required=True)
            sp.add_argument("--uri", required=True)
    a = ap.parse_args(argv)
    try:
        if a.verb == "put":
            try:
                rec = json.load(sys.stdin)
            except ValueError as e:
                raise q.Refusal("file-unreadable", f"standard input: {e}") from e
            q.put(rec, scope=a.scope, offer=a.offer, host_class=a.host_class, contract_dir=contract_dir(a.contract_dir),
                  root=a.root, schema=a.schema)
        else:
            q.delete(scope=a.scope, sha256=a.sha256, format=a.format, uri=a.uri, offer=a.offer, host_class=a.host_class,
                     root=a.root, schema=a.schema)
    except q.Refusal as e:
        print(f"{NAME}: refused: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
